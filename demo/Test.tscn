[sub_resource type="Shader" id="Shader_vwb7u"]
code = "shader_type canvas_item;

uniform float rotation : hint_range(0.0, 360.0) = 0.0;
uniform float fullness : hint_range(0.0, 1.0) = 0.5;


uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_nearest;
uniform float distortion_strength = 128.0;
uniform float margin_distortion_strength = 64.0;
uniform float distortion_factor = 4.0;
uniform float margin_distortion_factor = 2.0;
uniform float bottom_ratio : hint_range(0.0, 1.0) = 0.5;
uniform vec3 tint : source_color = vec3(0.1);

uniform float fluid_margin : hint_range(0.0, 0.5, 0.01) = 0.1;

uniform vec3 fluid_color_inner : source_color = vec3(1.0, 0.3, 0.4);
uniform vec3 fluid_color_outer : source_color = vec3(0.8, 0.15, 0.2);
uniform vec3 fluid_color_back : source_color = vec3(1.0, 0.725, 0.75);
uniform float fluid_gradient_strength : hint_range(1.0, 8.0, 0.1) = 3.0;
uniform float fluid_alpha : hint_range(0.0, 1.0, 0.1) = 0.8;

float curve(float lin, float dist) {
	return sign(lin) * abs(pow(abs(lin), dist));
}

vec2 curve(vec2 lin) {
	float l = length(lin);
	float dir = atan(lin.y, lin.x);
		
	return pow(l, distortion_factor) * vec2(cos(dir), sin(dir));
}

void fragment() {
	//float distortion = curve(2.0 * (UV.x - 0.5)) * SCREEN_PIXEL_SIZE.x;
	//
	//COLOR = texture(screen_texture, SCREEN_UV + vec2(distortion, 0.0) * distortion_strength);
	COLOR.b = 0.0;
	
	vec2 uv = UV;
	
	// Glass refraction
	
	// Top Cylinder
	if (UV.y < bottom_ratio) {
		uv.x = curve(UV.x * 2.0 - 1.0, mix(margin_distortion_factor, distortion_factor, step(0.5 - abs(UV.x - 0.5), fluid_margin / 2.0)));
		
		uv.y = 0.0;
	} else { // Bottom Sphere
		uv.x = UV.x * 2.0 - 1.0;
		uv.y = (UV.y - bottom_ratio) / (1.0 - bottom_ratio);
		if (length(uv) <= 1.0) {
			uv = curve(uv);
		} else {
			COLOR.a = 0.0;
		}
	}
	
	vec2 distortion = uv * distortion_strength * SCREEN_PIXEL_SIZE;
	float theta = -rotation;
	
	COLOR.rgb = texture(screen_texture, SCREEN_UV + vec2(
			distortion.x * cos(theta) + distortion.y * sin(theta), 
			-distortion.x * sin(theta) + distortion.y * cos(theta)
	)).rgb + tint;
	
	// Liquid
	
	vec3 fluid = COLOR.rgb;
	
	// Behind
	
	if (UV.y + (sin(2.0 * TIME + UV.x * 1.7) * 0.02) > 1.0 - fullness) {
		if (0.5 - abs(UV.x - 0.5) > fluid_margin / 2.0) {
			fluid = fluid_color_back;
		}
	}
	
	if (UV.y + (sin(2.0 * 1.414 * TIME + UV.x * 3.0) * 0.02) > 1.0 - fullness) {
		if (UV.y < bottom_ratio) {
			if (0.5 - abs(UV.x - 0.5) > fluid_margin / 2.0) {
				fluid = mix(fluid_color_inner, fluid_color_outer, abs(pow(abs(UV.x * (2.0 + fluid_margin * 2.0) - 1.0 - fluid_margin), fluid_gradient_strength)));
			}
		} else {
			uv.x = UV.x * (2.0 + fluid_margin * 2.0) - 1.0 - fluid_margin;
			uv.y = (UV.y - bottom_ratio) / (1.0 - bottom_ratio) * (1.0 + fluid_margin);
			float l = length(uv);
			if (l < 1.0 - fluid_margin / 4.0) {
				fluid = mix(fluid_color_inner, fluid_color_outer, abs(pow(l, fluid_gradient_strength)));
			}
			
		}
	}
	
	COLOR.rgb = mix(COLOR.rgb, fluid, fluid_alpha);
	
}

"

