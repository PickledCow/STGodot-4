[sub_resource type="Shader" id="Shader_s2xbw"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

uniform vec2 boss_center;
uniform float boss_force;
uniform float boss_size;

uniform vec2 player_center;
uniform float player_force;
uniform float player_size;

uniform float thickness;
uniform float abberation = 0.01;

void fragment() {
	float ratio = SCREEN_PIXEL_SIZE.x / SCREEN_PIXEL_SIZE.y;
		vec3 boss_mask;
	vec3 player_mask;

	boss_mask.r = (1.0 - smoothstep(
		boss_size - 0.1,
		boss_size,
		length(UV - boss_center)
	)) * smoothstep(
		boss_size - thickness - 0.1,
		boss_size - 0.1,
		length(UV - boss_center)
	);

	boss_mask.g = (1.0 - smoothstep(
		boss_size - 0.1 - abberation, boss_size,
		length(UV - boss_center)
	)) * smoothstep(
		boss_size - thickness - 0.1 - abberation,
		boss_size - 0.1,
		length(UV - boss_center)
	);

	boss_mask.b = (1.0 - smoothstep(
		boss_size - 0.1 - abberation * 2.0,
		boss_size,
		length(UV - boss_center)
	)) * smoothstep(
		boss_size - thickness - 0.1 - abberation * 2.0,
		boss_size-0.1,
		length(UV - boss_center)
	);

	vec2 boss_dispr = normalize(UV - boss_center) * boss_force * boss_mask.r;
	vec2 boss_dispg = normalize(UV - boss_center) * boss_force * boss_mask.g;
	vec2 boss_dispb = normalize(UV - boss_center) * boss_force * boss_mask.b;

	player_mask.r = (1.0 - smoothstep(
		player_size - 0.1,
		player_size,
		length(UV - player_center)
	)) * smoothstep(
		player_size - thickness - 0.1,
		player_size - 0.1,
		length(UV - player_center)
	);

	player_mask.g = (1.0 - smoothstep(
		player_size - 0.1 - abberation, player_size,
		length(UV - player_center)
	)) * smoothstep(
		player_size - thickness - 0.1 - abberation,
		player_size - 0.1,
		length(UV - player_center)
	);


	player_mask.b = (1.0 - smoothstep(
		player_size - 0.1 - abberation * 2.0,
		player_size,
		length(UV - player_center)
	)) * smoothstep(
		player_size - thickness - 0.1 - abberation * 2.0,
		player_size-0.1,
		length(UV - player_center)
	);

	vec2 player_dispr = normalize(UV - player_center) * player_force * player_mask.r;
	vec2 player_dispg = normalize(UV - player_center) * player_force * player_mask.g;
	vec2 player_dispb = normalize(UV - player_center) * player_force * player_mask.b;


	COLOR.rgb = vec3(
		texture(SCREEN_TEXTURE, SCREEN_UV - boss_dispr - player_dispr).r,
		texture(SCREEN_TEXTURE, SCREEN_UV - boss_dispg - player_dispg).g,
		texture(SCREEN_TEXTURE, SCREEN_UV - boss_dispb - player_dispb).b
	);


}
"

