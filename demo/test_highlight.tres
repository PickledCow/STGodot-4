[gd_resource type="ShaderMaterial" load_steps=2 format=3 uid="uid://dldg5jccl4tmy"]

[sub_resource type="Shader" id="Shader_j4y3t"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, unshaded;

uniform float margin = 0.05;
uniform float height_factor = 1.0;
uniform float time_scale = 0.5;
uniform float density : hint_range(1.0, 16.0, 1.0) = 4.0;
uniform float gap_duty_cycle : hint_range(0.0, 1.0) = 0.5;
uniform vec3 color : source_color;

vec2 get_rotated_uv(vec2 uv, vec2 uv_tex) {
	vec2 r_uv = vec2(0.0);
	r_uv.x = mix(uv.x, 1.0 - uv.x, step(1.0 / 3.0, uv_tex.x));
	r_uv.y = 1.0 - uv.y;
	
	// Why is the bottom face fucked?
	if (uv_tex.x > 2.0 / 3.0 && uv_tex.y > 0.5) {
		r_uv = vec2(1.0 - uv.y, uv.x);
	}
	
	return r_uv;
}


void fragment() {
	vec2 uv = get_rotated_uv(mod(UV * vec2(3.0, 2.0), 1.0), UV);
	
	ALBEDO = color;
	
	float h = mix(height_factor, 1.0, step(0.5, step(0.5, UV.y) * step(1.0 / 3.0, UV.x)));

	ALPHA = min(1.0, 
		mix(0.0, 1.0, step(1.0 - gap_duty_cycle, mod(uv.x * density - time_scale * TIME, 1.0))) * mix(1.0, 0.0, step(margin / h, 0.5 - abs(0.5 - uv.y))) + 
		mix(0.0, 1.0, step(1.0 - gap_duty_cycle, mod(uv.y * density * h - time_scale * TIME * h, 1.0))) * mix(1.0, 0.0, step(margin, 0.5 - abs(0.5 - uv.x)))
	);

}
"

[resource]
render_priority = 0
shader = SubResource("Shader_j4y3t")
shader_parameter/margin = 0.1
shader_parameter/height_factor = 2.0
shader_parameter/time_scale = 0.5
shader_parameter/density = 4.0
shader_parameter/gap_duty_cycle = 0.5
shader_parameter/color = Color(1, 0, 0, 1)
