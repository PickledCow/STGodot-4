[sub_resource type="Shader" id="Shader_egg54"]
code = "shader_type canvas_item;

uniform vec4 left_color : source_color;
uniform vec4 right_color : source_color; 

uniform float progress = 0.0;

void fragment() {
	vec4 c = COLOR;
	if (c.r > 0.9) {
		c.rgb = left_color.rgb + (right_color.rgb - left_color.rgb) * UV.x * progress;
	}
	COLOR = c;
}"

