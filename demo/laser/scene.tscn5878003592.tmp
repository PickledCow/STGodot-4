[gd_scene load_steps=2 format=3 uid="uid://7x5p3a1jc76l"]

[sub_resource type="GDScript" id="GDScript_208yb"]
script/source = "extends Node2D

const LASER = preload(\"uid://dsqkna2m1uf1q\")
@onready var label: Label = $Label

func _ready() -> void:
	for i in 128:
		var l := LASER.instantiate()
		l.position = get_viewport_rect().get_center() / 2.0
		l.rotate(randf())
		add_child(l)

func _process(delta: float) -> void:
	label.text = str(Performance.get_monitor(Performance.TIME_FPS))
"

[node name="Node2D" type="Node2D"]
script = SubResource("GDScript_208yb")

[node name="Label" type="Label" parent="."]
offset_right = 40.0
offset_bottom = 23.0
